[Desktop Entry]
Type=Application
Name=Pulse
GenericName=Telegram Client
Comment=Native Telegram desktop client for the Nixe Suite
Exec=nixe-pulse %U
Icon=io.github.design_nexus.nixe.Pulse
Terminal=false
Categories=Network;InstantMessaging;Chat;GTK;
Keywords=telegram;chat;messaging;im;pulse;nixe;calls;
MimeType=x-scheme-handler/nixe-pulse;x-scheme-handler/tg;
StartupNotify=true
StartupWMClass=io.github.design_nexus.nixe.Pulse
SingleMainWindow=true
DBusActivatable=false
